# ── Paste into Render → your service → Environment ───────────────────────────

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# From https://rapidapi.com → "Twitter API v2" by twitter-api45 (free tier)
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated Telegram user IDs who can issue commands (leave blank = anyone)
# Get your ID from @userinfobot on Telegram
ADMIN_USER_IDS=123456789

# Poll interval in seconds (default 300 = 5 min). Set in render.yaml already.
# POLL_INTERVAL_SECONDS=300

# REDIS_URL is wired automatically by render.yaml — do NOT set manually.

# Note: TELEGRAM_CHANNEL_ID is no longer needed.
# The bot tracks each channel independently based on where commands are sent.

# Local development only — on Fly.io use: fly secrets set KEY=value

TELEGRAM_BOT_TOKEN=123456789:ABCdef...
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional — comma-separated Telegram user IDs allowed to use commands
# Get your ID from @userinfobot on Telegram
ADMIN_USER_IDS=123456789

# REDIS_URL is set automatically when you run: fly ext upstash redis create
# Do NOT set this manually on Fly.io
